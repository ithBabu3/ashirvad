server {
  listen 80;
  server_name yourdomain.com;
  root /var/www/site;
  index index.html;
  location / { try_files $uri $uri/ =404; }          # /admin/ -> admin/index.html
  location ~* \.(css|js)$ { expires 7d; add_header Cache-Control "public"; }
  location ~* \.html$    { add_header Cache-Control "no-cache"; }
}
