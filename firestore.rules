rules_version = '2';

// AshirvadConnect — Firestore security rules
// Deploy with:  firebase deploy --only firestore:rules
//
// Who is who
//   admin   : a Firebase Auth user whose uid has a document in /admins  (created by setup/setup.js)
//   dealer  : a Firebase Auth user whose e-mail is  <phone>@dealer.ashirvadconnect.app
//   Every dealer-owned document carries  accountKey = the dealer's phone number.
//   (If you change the e-mail domains in js/firebase-config.js, change the regex below too.)

service cloud.firestore {
  match /databases/{database}/documents {

    function isDistributor() { return request.auth != null && request.auth.token.email != null
                                      && request.auth.token.email.matches('.*@distributor[.]ashirvadconnect[.]app'); }
    function myDistId()      { return request.auth.token.email.split('@')[0]; }
    function distDoc()       { return get(/databases/$(database)/documents/distributors/$(myDistId())).data; }
    function signedIn()  { return request.auth != null; }
    // distributors are signed in too, but must NEVER read the catalogue (it holds dealer prices + warehouse stock)
    function staffOrDealer() { return signedIn() && !isDistributor(); }
    function isAdmin()   { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isDealer()  { return signedIn() && request.auth.token.email != null
                                  && request.auth.token.email.matches('.*@dealer[.]ashirvadconnect[.]app'); }
    function myPhone()   { return request.auth.token.email.split('@')[0]; }
    function mine(data)  { return isDealer() && data.accountKey == myPhone(); }
    function changes(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasAny(keys); }

    // ---- who is an admin (read-only from the app; only the setup script can add admins) ----
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---- shared catalogue & configuration: every signed-in user reads, only admin writes ----
    match /products/{id}               { allow read: if staffOrDealer(); allow write: if isAdmin(); }
    match /spec_groups/{id}            { allow read: if staffOrDealer(); allow write: if isAdmin(); }
    match /catalog_categories/{id}     { allow read: if staffOrDealer(); allow write: if isAdmin(); }
    match /catalog_subcategories/{id}  { allow read: if staffOrDealer(); allow write: if isAdmin(); }
    match /offers/{id}                 { allow read: if staffOrDealer(); allow write: if isAdmin(); }
    match /banners/{id}                { allow read: if staffOrDealer(); allow write: if isAdmin(); }
    match /calc_rules/{id}             { allow read: if staffOrDealer(); allow write: if isAdmin(); }
    match /broadcasts/{id}             { allow read: if staffOrDealer(); allow write: if isAdmin(); }
    match /config/settings             { allow read: if staffOrDealer(); allow write: if isAdmin(); }

    // ---- running invoice counter: anyone signed in may raise it, never lower it ----
    match /config/invoice_seq {
      allow read: if staffOrDealer();
      allow create: if staffOrDealer() && request.resource.data.n is number;
      allow update: if isAdmin() || (staffOrDealer() && request.resource.data.n is number
                                     && request.resource.data.n >= resource.data.n);
    }

    // ---- dealer profiles ----
    match /dealers/{gst} {
      allow read: if isAdmin() || mine(resource.data);
      // a dealer may register a profile for themselves — but never grant themselves a tier / discount / prices
      allow create: if isAdmin() || (isDealer()
                        && request.resource.data.accountKey == myPhone()
                        && request.resource.data.keys().hasOnly(['business','gst','phone','address','contactPerson',
                              'email','deliveryAddress','tier','notes','standingDiscountPct','accountKey'])
                        && request.resource.data.get('tier', 'Standard') == 'Standard'
                        && request.resource.data.get('standingDiscountPct', 0) == 0);
      allow update: if isAdmin() || (mine(resource.data)
                        && request.resource.data.accountKey == resource.data.accountKey
                        && !changes(['tier','standingDiscountPct','priceOverrides','creditLimit','isActive',
                                     'blockReason','notes','autoStatusRule','gst']));
      allow delete: if isAdmin();
    }

    // ---- login accounts (phone -> list of linked GST profiles) ----
    match /accounts/{phone} {
      allow read: if isAdmin() || (isDealer() && phone == myPhone());
      allow create, update: if isAdmin() || (isDealer() && phone == myPhone()
                                             && request.resource.data.keys().hasOnly(['gsts']));
      allow delete: if isAdmin();
    }

    // ---- orders ----
    match /orders/{id} {
      allow read: if isAdmin() || mine(resource.data);
      allow create: if isAdmin() || (mine(request.resource.data)
                        && exists(/databases/$(database)/documents/dealers/$(request.resource.data.dealerGst))
                        && get(/databases/$(database)/documents/dealers/$(request.resource.data.dealerGst)).data.accountKey == myPhone());
      // a dealer can cancel / mark seen / trigger an invoice number — but never change what was ordered or the price
      allow update: if isAdmin() || (mine(resource.data)
                        && request.resource.data.accountKey == resource.data.accountKey
                        && !changes(['items','total','deliveryCharge','dealerGst','id','discount','createdAt'])
                        && !(changes(['invoiceNo']) && 'invoiceNo' in resource.data));
      allow delete: if isAdmin();
    }

    // ---- payments / credit ledger: dealers may read their own, only admin writes ----
    match /payments/{id} {
      allow read: if isAdmin() || mine(resource.data);
      allow write: if isAdmin();
    }

    // ---- "notify me when back in stock" requests ----
    match /stock_notify/{id} {
      allow read: if isAdmin() || mine(resource.data);
      allow create: if isAdmin() || mine(request.resource.data);
      allow update: if isAdmin() || (mine(resource.data) && request.resource.data.accountKey == resource.data.accountKey);
      allow delete: if isAdmin() || mine(resource.data);
    }

    // ---- audit trail: anyone signed in can add a line, only admin can read / change it ----
    match /audit_log/{id} {
      allow create: if staffOrDealer();
      allow read, update, delete: if isAdmin();
    }

        // ---- distributors ----
    match /distributors/{id} {
      allow read: if isAdmin() || (isDistributor() && id == myDistId());
      allow create, delete: if isAdmin();
      // a distributor may only tap "all up to date" (lastConfirmedAt) on his own doc
      allow update: if isAdmin() || (isDistributor() && id == myDistId()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastConfirmedAt'])
            && request.resource.data.lastConfirmedAt is number);
    }

    // one doc per (distributor, product) => same product never duplicates.
    // admin controls visible / showPrice / price snapshot; distributor may ONLY change qty.
    match /distributor_stock/{id} {
      allow read: if isAdmin() || (isDistributor() && resource.data.distributorId == myDistId()
                                   && resource.data.visible == true);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isDistributor()
            && resource.data.distributorId == myDistId()
            && resource.data.visible == true
            && distDoc().isActive == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qty', 'updatedAt', 'updatedBy'])
            && request.resource.data.qty is number && request.resource.data.qty >= 0);
    }

    // new-product requests (only if admin switched "can upload" on for that distributor)
    match /distributor_requests/{id} {
      function reqOk(d) {
        return d.distributorId == myDistId() && d.status == 'pending'
          && d.keys().hasOnly(['id','distributorId','name','size','part','partKey','mrp','qty','note','status','createdAt'])
          && d.qty is number && d.qty >= 0;
      }
      allow read: if isAdmin() || (isDistributor() && resource.data.distributorId == myDistId());
      allow create: if isAdmin() || (isDistributor() && reqOk(request.resource.data)
                        && distDoc().canUpload == true && distDoc().isActive == true);
      allow update: if isAdmin() || (isDistributor() && resource.data.distributorId == myDistId()
                        && resource.data.status in ['pending', 'rejected'] && reqOk(request.resource.data));
      allow delete: if isAdmin() || (isDistributor() && resource.data.distributorId == myDistId()
                        && resource.data.status in ['pending', 'rejected']);
    }

    // stock-change history
    match /distributor_log/{id} {
      allow read: if isAdmin() || (isDistributor() && resource.data.distributorId == myDistId());
      allow create: if isAdmin() || (isDistributor() && request.resource.data.distributorId == myDistId()
                    && request.resource.data.keys().hasOnly(['distributorId','productId','name','part','from','to','ts']));
      allow update, delete: if false;
    }

  }
}
